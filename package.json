{
  "name": "bmw-route-dash",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "android": "pnpm expo run:android",
    "ios": "pnpm expo run:ios",
    "lint": "expo lint",
    "type:check": "tsc --noEmit",
    "lint:fix": "pnpm lint --fix",
    "prettier:check": "prettier \"**/*.{js,json,ts,tsx,md}\"",
    "format": "pnpm prettier:check --write",
    "expo:doctor": "npx expo-doctor@latest",
    "expo:doctor:fix": "npx expo install --check",
    "clean": "rm -rf node_modules .expo",
    "nuke": "rm -rf node_modules .expo android ios",
    "prepare": "husky"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.10",
    "nativewind": "5.0.0-preview.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-css": "^3.0.1",
    "react-native-reanimated": "~4.1.6",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^20.4.1",
    "@secretlint/secretlint-rule-preset-recommend": "^11.3.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/react": "~19.1.0",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "react-test-renderer": "19.1.0",
    "secretlint": "^11.3.1",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.2"
  },
  "private": true,
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "*": [
      "secretlint"
    ],
    "**/*.+(js|jsx|ts|tsx)": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.+(json|md|mdx)": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "lightningcss": "1.30.1"
    }
  }
}
